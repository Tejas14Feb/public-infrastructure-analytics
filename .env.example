# Snowflake connection settings for the ingestion script.
# Copy this file to .env and fill in the blanks. Never commit .env.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=LOADER_SVC
SNOWFLAKE_ROLE=LOADER
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_DATABASE=RAW
SNOWFLAKE_SCHEMA=USASPENDING
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/loader_svc_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
DBT_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=